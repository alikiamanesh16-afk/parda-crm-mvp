# فایل نمونه — کپی کن به .env و مقدارها را بده
# وقتی تیم دیتابیس آدرس و کلید داد، اینجا پر می‌شود:

PARDA_API_BASE_URL=
PARDA_API_KEY=

# کلید CRM که فرانت در هدر X-API-Key می‌فرستد
CRM_API_KEY=dev-crm-key

# CORS — با کاما جدا
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# وب‌هوک (فاز ۳)
WEBHOOK_SECRET=

# True = دیتای نمونه؛ بعد از پر کردن URL بالا → False
MOCK_MODE=True
